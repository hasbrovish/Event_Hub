# Copy to `.env` in the **repository root** (same folder as docker-compose.yml).
# Docker Compose loads this file automatically for variable substitution.
#
# On another machine: copy this file to `.env` before `docker compose up -d`.
# If port 5432 is already taken locally, set POSTGRES_PORT=5433 and update
# backend/.env DATABASE_URL / SYNC_DATABASE_URL to use that port.

POSTGRES_PORT=5432
