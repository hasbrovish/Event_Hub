# Copy to .env and adjust. Used by FastAPI (async) and Alembic (sync URL).
# Docker: if repo-root .env sets POSTGRES_PORT, use that port below.
# No Docker: see planning/LOCAL_POSTGRES_SETUP.md and scripts/init_local_db.sql
DATABASE_URL=postgresql+asyncpg://eventhub:eventhub@127.0.0.1:5432/eventhub
SYNC_DATABASE_URL=postgresql+psycopg2://eventhub:eventhub@127.0.0.1:5432/eventhub

# JWT (change in production)
JWT_SECRET=event-hub-dev-secret-change-in-production-min-32-chars!!
ALLOW_DEV_LOGIN=true
